{
  "name": "vocalyx",
  "version": "0.1.0-beta",
  "description": "VocaLyx — Desktop Music Manager | Vocal Isolation | Karaoke & EQ",
  "author": "Arif Mundhofir",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ndova/vocalyx"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "stage:clean": "python scripts/clean_release_stage.py",
    "stage:check": "python scripts/clean_release_stage.py --check",
    "tauri": "tauri",
    "engine": "python -u python-engine/server.py",
    "dev:all": "concurrently -k \"python -u python-engine/server.py\" \"tauri dev\"",
    "smoke": "node tests/smoke.mjs",
    "smoke:py": "python python-engine/tests/check_undefined_names.py && python python-engine/tests/test_api_surface.py && python python-engine/tests/test_karaoke_dsp.py",
    "test": "npm run smoke && npm run smoke:py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "concurrently": "^9.2.4",
    "jsdom": "^30.0.1",
    "terser": "^5.51.2",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "music-metadata-browser": "^2.5.10"
  }
}
