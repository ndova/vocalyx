{
  "name": "vocalyx",
  "version": "0.1.0-beta",
  "description": "VocaLyx — Desktop Music Manager | Vocal Isolation | Karaoke & EQ",
  "author": "Arif Mundhofir",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ndova/vocalyx"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "stage:clean": "scripts\\py311.cmd scripts/clean_release_stage.py",
    "stage:engine": "scripts\\py311.cmd scripts/build_runtime.py --staging-only",
    "stage:premium": "scripts\\py311.cmd scripts/stage_premium.py",
    "stage:runtime": "scripts\\py311.cmd scripts/build_runtime.py --repack",
    "stage:check": "scripts\\py311.cmd scripts/clean_release_stage.py --check",
    "protect:release": "scripts\\py311.cmd scripts/clean_release_artifacts.py",
    "protect:check": "scripts\\py311.cmd scripts/clean_release_artifacts.py --check",
    "tauri": "tauri",
    "engine": "scripts\\run-engine.cmd",
    "dev:all": "concurrently \"cmd /c scripts\\run-engine.cmd\" \"tauri dev\"",
    "dev:web": "concurrently \"cmd /c scripts\\run-engine.cmd\" \"vite\"",
    "smoke": "node tests/smoke.mjs",
    "smoke:py": "scripts\\py311.cmd python-engine/tests/check_undefined_names.py && scripts\\py311.cmd python-engine/tests/test_api_surface.py && scripts\\py311.cmd python-engine/tests/test_karaoke_dsp.py && scripts\\py311.cmd python-engine/tests/test_engine_auth.py",
    "test": "npm run smoke && npm run smoke:py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "concurrently": "^9.2.4",
    "jsdom": "^30.0.1",
    "terser": "^5.51.2",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "music-metadata-browser": "^2.5.10"
  }
}
