{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VocaLyx",
  "version": "0.1.0-beta",
  "identifier": "com.vocalyx.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run stage:engine && npm run stage:clean && npm run stage:premium && npm run stage:runtime"
  },
  "app": {
    "windows": [
      {
        "title": "VocaLyx",
        "width": 1240,
        "height": 740,
        "minWidth": 960,
        "minHeight": 600,
		"center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true
		
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "publisher": "Ndova",
    "copyright": "Copyright (c) 2026 Ndova",
    "shortDescription": "Desktop Music Manager | Vocal Isolation | Karaoke & EQ",
    "resources": {
      "../build/engine": "python-engine",
      "../build/premium": "premium",
      "../build/runtime-bundle.zip": "runtime-bundle.zip",
      "../assets": "assets"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      },
      "wix": {
        "version": "0.1.0.0"
      }
    }
  },
  "plugins": {}
}
