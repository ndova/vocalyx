{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VocaLyx",
  "version": "0.1.0",
  "identifier": "com.vocalyx.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VocaLyx",
        "width": 1240,
        "height": 740,
        "minWidth": 960,
        "minHeight": 600,
		"center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true
		
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Desktop Music Manager | Vocal Isolation | Karaoke & EQ",
    "resources": ["../python-engine", "../assets"]
  },
  "plugins": {}
}
